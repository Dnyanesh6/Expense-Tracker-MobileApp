# Expo public environment variables are inlined into the app bundle at build
# time, so do NOT put secrets here. This URL is only the address of your API.

# Point this at the machine running the Express API (server/):
#   - Physical device (Expo Go) on the same Wi-Fi : http://<your-lan-ip>:4000
#   - Android emulator                            : http://10.0.2.2:4000
#   - iOS simulator                               : http://localhost:4000
#
# Find your LAN IP:  ipconfig (Windows) | ifconfig / ip addr (macOS/Linux)
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000
